classDiagram
    %% PawPal+ system design — keep this file in sync with pawpal_system.py

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet)
        +remove_pet(pet)
        +get_pets()
    }

    class Pet {
        +str name
        +str species
        +int age
        +Owner owner
        +list~Task~ tasks
        +add_task(task)
        +remove_task(task)
        +get_tasks()
    }

    class Task {
        +str name
        +int duration
        +int priority
        +str preferred_time
        +str recurring
        +date due_date
        +bool complete
        +Pet pet
        +mark_complete()
        +is_recurring()
        +next_occurrence()
        +priority_label()
        -_next_instance()
        -_next_due_date()
    }

    class Scheduler {
        +Owner owner
        +int time_budget
        +list~Task~ tasks
        +list~Task~ plan
        +sort_tasks()
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
        +classify_conflicts()
        +conflict_warning()
        +generate_plan()
        +explain_plan()
        -_collect_tasks()
        -_overlaps()
        -_safe_overlaps()
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" o-- "*" Task : has
    Scheduler ..> Owner : reads time budget
    Scheduler ..> Task : schedules
